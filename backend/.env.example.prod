# Copy to backend/.env on the production host. Never commit real secrets.
# Production startup fails fast if required values are missing or insecure.

ENVIRONMENT=production
DOCS_ENABLED=false

# Hostname(s) the backend is reachable on, without scheme or wildcards.
# If the API and frontend share one domain, use that same hostname here.
ALLOWED_HOSTS=api.example.com

# Exact browser origin(s) allowed by CORS and session-token validation.
# Include the real frontend origin(s), without trailing slashes.
# This is required even for same-origin POST requests (e.g. /api/session).
TAJWEED_CORS_ORIGINS=https://example.com,https://www.example.com

# Generate with: openssl rand -base64 48
# Must be at least 32 characters. CHANGE_ME is intentionally too short so
# startup fails until you replace it.
SESSION_TOKEN_SECRET=CHANGE_ME
SESSION_TOKEN_TTL=600

# Leave empty. The browser app cannot keep a server-side key secret; setting
# this makes the middleware require X-API-Key on every /api call and the app
# will return 401. Protect the backend at the edge instead.
API_ACCESS_KEY=

# Set true when running behind a reverse proxy / load balancer that supplies
# X-Forwarded-For and X-Real-IP.
TRUST_PROXY_HEADERS=true

# Tajweed upload/analysis limits.
TAJWEED_MAX_UPLOAD_BYTES=15728640
TAJWEED_MAX_SECONDS=30
# Use demo unless a Quran-Muaalem model is installed and TAJWEED_MODEL is set.
# Valid values: auto, demo, off, muaalem, real.
TAJWEED_ENGINE=demo
TAJWEED_MODEL=
TAJWEED_DEVICE=cpu
TAJWEED_MADD_MONFASEL=2
TAJWEED_MADD_MOTTASEL=4
TAJWEED_MADD_WAQF=4
TAJWEED_MADD_AARED=2

# Upstream APIs. Both must be HTTPS in production.
PRAYER_API_BASE_URL=https://api.aladhan.com/v1
PRAYER_API_KEY=
PRAYER_METHOD=2
PRAYER_CACHE_SECONDS=21600
PRAYER_UPSTREAM_TIMEOUT=6

QURAN_API_BASE_URL=https://api.alquran.cloud/v1
QURAN_CACHE_SECONDS=86400

# Abuse controls.
RATE_SESSION_PER_MINUTE=10
RATE_PRAYER_PER_MINUTE=60
RATE_TAJWEED_PER_MINUTE=10
RATE_TAJWEED_PER_DAY=100
INFERENCE_MAX_CONCURRENCY=2
INFERENCE_QUEUE_TIMEOUT=10
