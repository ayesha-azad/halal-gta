# Backend configuration. Copy to .env for local overrides; never commit .env.

ENVIRONMENT=development
DOCS_ENABLED=false
ALLOWED_HOSTS=*
TAJWEED_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Shared secret for a trusted reverse proxy. Leave blank for local development.
API_ACCESS_KEY=
# Required in production (>=32 chars). Dev generates a temporary one.
SESSION_TOKEN_SECRET=
SESSION_TOKEN_TTL=600
TRUST_PROXY_HEADERS=false

TAJWEED_MAX_UPLOAD_BYTES=15728640
TAJWEED_MAX_SECONDS=30
TAJWEED_ENGINE=auto
TAJWEED_MODEL=
TAJWEED_DEVICE=cpu

# Adhan API base URL. Kept here (not in source) so it can be changed per host.
# Production requires HTTPS.
PRAYER_API_BASE_URL=https://api.aladhan.com/v1
PRAYER_API_KEY=
PRAYER_METHOD=2
PRAYER_CACHE_SECONDS=21600
PRAYER_UPSTREAM_TIMEOUT=6

# Quran Cloud API for the daily Ayah rotation.
QURAN_API_BASE_URL=https://api.alquran.cloud/v1

RATE_SESSION_PER_MINUTE=10
RATE_PRAYER_PER_MINUTE=60
RATE_TAJWEED_PER_MINUTE=10
RATE_TAJWEED_PER_DAY=100
INFERENCE_MAX_CONCURRENCY=2
INFERENCE_QUEUE_TIMEOUT=10
