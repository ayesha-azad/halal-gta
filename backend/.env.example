# Copy to backend/.env and adjust locally. NEVER commit the real .env file.

# Runtime mode. "production" disables docs and requires explicit host/CORS lists.
ENVIRONMENT=development
DOCS_ENABLED=true
ALLOWED_HOSTS=*

# Browser origins allowed to call this API. Never use "*" in production.
TAJWEED_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Upload/recording limits.
TAJWEED_MAX_UPLOAD_BYTES=15728640
TAJWEED_MAX_SECONDS=30

# Optional shared secret for the trusted proxy / server-to-server clients
# (X-API-Key header). Leave blank for local development without a proxy.
# In production set a >=32 char random value here (via the secret manager),
# and have the proxy inject it. Never put this in frontend/.env.
API_ACCESS_KEY=

# Secret used to sign short-lived anonymous browser tokens. These tokens are
# abuse control, not identity. Required (>=32 chars) in production.
SESSION_TOKEN_SECRET=
SESSION_TOKEN_TTL=600

# Only enable when the API is behind a proxy that strips client-supplied
# X-Forwarded-For / X-Real-IP headers. Defaults to true in production.
TRUST_PROXY_HEADERS=false

# Browser-safe abuse limits. Tokens are preferred over IPs as rate-limit keys.
RATE_SESSION_PER_MINUTE=10
RATE_PRAYER_PER_MINUTE=60
RATE_TAJWEED_PER_MINUTE=10
RATE_TAJWEED_PER_DAY=100
INFERENCE_MAX_CONCURRENCY=2
INFERENCE_QUEUE_TIMEOUT=10

# Tajweed engine. auto|demo|off|muaalem|real
# Replace the placeholder with your own model id. Never commit the real value.
TAJWEED_ENGINE=auto
TAJWEED_MODEL=your-org/your-model
TAJWEED_DEVICE=cpu
TAJWEED_MADD_MONFASEL=2
TAJWEED_MADD_MOTTASEL=4
TAJWEED_MADD_WAQF=4
TAJWEED_MADD_AARED=2

# Upstream prayer-times API. The browser never calls this directly.
# Replace with your own endpoint; no endpoint is hard-coded in the source.
PRAYER_API_BASE_URL=https://your-prayer-api.example/v1
# Optional key sent as X-API-Key to a private/proxy prayer-times API.
PRAYER_API_KEY=
PRAYER_METHOD=2
PRAYER_CACHE_SECONDS=21600
PRAYER_UPSTREAM_TIMEOUT=6
