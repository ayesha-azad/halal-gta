# Copy to frontend/.env. NEVER commit the real .env file.
#
# IMPORTANT: Vite exposes every VITE_* variable to the browser and embeds it in
# the production bundle. These values are public configuration, not secrets.
# Keep API keys and backend secrets in backend/.env only.

# Same-origin "/api" is the safest default (use a reverse proxy in production).
VITE_API_URL=/api
VITE_TAJWEED_API_URL=/api/tajweed

# Dev-server settings. API_PROXY_TARGET has no VITE_ prefix on purpose: Vite
# reads it in Node when starting the dev server and does not bundle it.
API_PROXY_TARGET=http://127.0.0.1:8001
VITE_DEV_HOST=127.0.0.1
VITE_DEV_PORT=5173
