# Frontend configuration. All VITE_* values are public and bundled.
# Same-origin defaults work with the Vite proxy and a reverse proxy in production.

VITE_API_URL=/api
VITE_TAJWEED_API_URL=/api/tajweed

# Dev server only — never bundled into the browser.
API_PROXY_TARGET=http://127.0.0.1:8001
VITE_DEV_HOST=127.0.0.1
VITE_DEV_PORT=5173
