# Copy to frontend/.env.production before running `npm run build`.
# These values are public and end up in the built JavaScript bundle.

# Option A: backend on its own HTTPS host (CORS must allow this frontend origin).
VITE_API_URL=https://api.example.com/api
VITE_TAJWEED_API_URL=https://api.example.com/api/tajweed

# Option B: frontend and backend behind one domain with /api proxied at the edge.
# Comment out Option A and use these instead:
# VITE_API_URL=/api
# VITE_TAJWEED_API_URL=/api/tajweed

# Dev-only settings (ignored by `npm run build`; leave them out in production):
# API_PROXY_TARGET=http://127.0.0.1:8001
# VITE_DEV_HOST=127.0.0.1
# VITE_DEV_PORT=5173
