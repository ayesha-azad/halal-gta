# nginx reverse proxy for the halal-gta API.
# Replace __API_ACCESS_KEY__ at deploy time, e.g.:
#   export API_ACCESS_KEY="$(openssl rand -hex 32)"
#   envsubst '${API_ACCESS_KEY}' < nginx.conf.example > /etc/nginx/conf.d/api.conf
#
# The backend must only accept traffic from this proxy (firewall/security group).

limit_req_zone $binary_remote_addr zone=gta_session:10m rate=10r/m;
limit_req_zone $binary_remote_addr zone=gta_prayer:10m rate=60r/m;
limit_req_zone $binary_remote_addr zone=gta_tajweed:10m rate=10r/m;

server {
    listen 443 ssl http2;
    server_name api.example.com;

    ssl_certificate     /etc/ssl/example.com/fullchain.pem;
    ssl_certificate_key /etc/ssl/example.com/privkey.pem;

    # A little more than TAJWEED_MAX_UPLOAD_BYTES for multipart overhead.
    client_max_body_size 16m;
    client_body_timeout 15s;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;

    location /api/session {
        limit_req zone=gta_session burst=20 nodelay;
        include /etc/nginx/snippets/gta_proxy.conf;
    }

    location /api/prayer-times {
        limit_req zone=gta_prayer burst=120 nodelay;
        include /etc/nginx/snippets/gta_proxy.conf;
    }

    location /api/tajweed/check {
        limit_req zone=gta_tajweed burst=20 nodelay;
        include /etc/nginx/snippets/gta_proxy.conf;
    }

    location / {
        include /etc/nginx/snippets/gta_proxy.conf;
    }
}

# /etc/nginx/snippets/gta_proxy.conf
